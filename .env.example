# App runtime database — Supabase pooled connection (pgbouncer/transaction pooler, port 6543).
DATABASE_URL=postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres

# Direct (non-pooled) connection — used only for DDL (npm run db:sync). Port 5432.
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

AUTH_SECRET=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Backup/sync script only (scripts/backup-sync.ts) — never read by the app itself.
BACKUP_SOURCE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
BACKUP_TARGET_URL=postgresql://postgres:postgres@localhost:5432/millimed_main

# HMAC secret used to hash external API keys (app/api/v1/**).
API_KEY_HASH_SECRET=
